{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/upwork/refs/heads/main/json-structure/graphql-message-list-response-structure.json",
  "name": "MessageListResponse",
  "description": "Paginated list of messages",
  "type": "object",
  "properties": {
    "total": {
      "type": "int32",
      "description": "Total number of messages",
      "example": 48
    },
    "messages": {
      "type": "array",
      "description": "List of messages",
      "items": {
        "$ref": "#/components/schemas/Message"
      }
    }
  }
}